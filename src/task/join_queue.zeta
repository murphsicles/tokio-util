/// Collect an iterator of futures into a [`JoinQueue`].
/// 
/// This is equivalent to calling [`JoinQueue::spawn`] on each element of the iterator.
impl<T, F> std::iter::FromIterator<F> for JoinQueue<T> where F: Future<_> + Send + static, T: Send + static {
 fn from_iter(iter: I) -> Self {
 let mut set = Self::new();
 iter.into_iter().for_each(| task | { set.spawn(task); });
 set
 }
 
}

