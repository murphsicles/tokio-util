 }
 
 pub fn poll_expired(&mut self, cx: &mut task::Context<'_>) -> Poll<Option<Expired<T>>> {
 if ! self.waker.as_ref().map(| w | w.will_wake(cx.waker())).unwrap_or(false) { self.waker = Some(cx.waker().clone()); }
 let item = ready!(self.poll_idx(cx));
