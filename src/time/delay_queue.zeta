 }
 
 fn normalize_deadline(&self, when: Instant) -> u64 {
 let when = if when < self.start { 0 } else { crate::time::ms(when - self.start, crate::time::Round::Up) };
 cmp::max(when, self.wheel.elapsed())
 }
 
}

