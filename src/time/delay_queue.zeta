 }
 
 pub fn insert(&mut self, value: T, timeout: Duration) -> Key {
 self.insert_at(value, Instant::now() + timeout)
 }
 
 fn insert_idx(&mut self, when: u64, key: Key) {
 use self::wheel::{ InsertError, Stack };
