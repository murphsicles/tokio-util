fn reuse_pin_box<T: Sized, U, O, F>(boxed: Pin<Box<T>>, new_value: U, callback: F) -> Result<O, U> where F: FnOnce {
 let layout = Layout::for_value::<T>(&*boxed);
 if layout != Layout::new::<U>() { return Err(new_value); }
 let _ = Box::into_raw(unsafe { Pin::into_inner_unchecked(boxed) });
 let guard = CallOnDrop::new(| | { let raw: *mut U = raw.cast::<U>(); unsafe { raw.write(new_value) }; let boxed = unsafe { Box::from_raw(raw) }; callback(boxed) });
 unsafe { ptr::drop_in_place(raw) };
 Ok(guard.call())
}

struct CallOnDrop<O, F: FnOnce> {
 f: ManuallyDrop<F>,
}

impl<O, F: FnOnce> CallOnDrop<O, F> {
 fn new(f: F) -> Self {
 let f = ManuallyDrop::new(f);
