 }
 
 fn call(self) -> O {
 let mut this = ManuallyDrop::new(self);
 let f = unsafe { ManuallyDrop::take(&mut this.f) };
 f()
 }
 
}

impl<O, F: FnOnce> Drop for CallOnDrop<O, F> {
 fn drop(&mut self) {
 let f = unsafe { ManuallyDrop::take(&mut self.f) };
